@page
@model GharchNews.Pages.Admin.User.IndexModel
@{
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
}

<p>
    <a asp-page="Register" class="btn btn-success">ایجاد کاربر جدید</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Users[0].ProfileImage)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Users[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Users[0].Family)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Users[0].PhoneNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Users[0].UserName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Users[0].InRole)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Users)
        {
            <tr>
                <td>
                    @if (item.ProfileImage == null)
                    {
                        <img src="/Img/ProfileImages/پروفایل.jpg" style="width:45px; height:45px; max-width:45px" class="img-circle" />
                    }
                    else
                    {
                        <img src="/Img/ProfileImages/@Html.DisplayFor(modelItem => item.ProfileImage)" style="width:45px; height:45px; max-width:45px" class="img-circle" />
                    }
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Family)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PhoneNumber)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.UserName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.InRole)
                </td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-warning">ویرایش</a>
                    <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-danger">حذف</a>
                </td>
            </tr>
        }
    </tbody>
</table>
