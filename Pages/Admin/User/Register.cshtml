@page
@model RegisterModel
@{
    ViewData["Title"] = "ثبت نام";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
}

<h4 class="text-success"> افزودن کاربر جدید </h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" enctype="multipart/form-data" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <label asp-for="Input.Name">نام </label>
                <input asp-for="Input.Name" class="form-control" placeholder="نام را وارد کنید" /> 
                <span asp-validation-for="Input.Name" class="text-danger"></span> <br />
            </div>
            <div class="form-floating mb-3">
                <label asp-for="Input.Family">نام خانوادگی</label> 
                <input asp-for="Input.Family" class="form-control" placeholder="نام خانوادگی را وارد کنید" /> 
                <span asp-validation-for="Input.Family" class="text-danger"></span> <br />
            </div>
            <div class="form-floating mb-3">
                <label asp-for="Input.PhoneNumber">شماره تماس</label>
                <input asp-for="Input.PhoneNumber" class="form-control" placeholder="شماره تماس را وارد کنید" /> 
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span> <br />
            </div>
            <div class="form-floating mb-3">
                <label asp-for="Input.ProfileImage">تصویر پروفایل</label>
                <input asp-for="imgUp" type="file" name="imgUp" id="imgUpload" /> <hr />
                <img id="imgpreview" style="max-width:320px" /> 
                <span asp-validation-for="Input.ProfileImage" class="text-danger"></span> <br />
            </div>
            <div class="form-floating mb-3">
                <label asp-for="Input.UserName">نام کاربری</label>
                <input asp-for="Input.UserName" class="form-control" autocomplete="username" aria-required="true" placeholder="نام کاربری را وارد کنید" /> 
                <span asp-validation-for="Input.UserName" class="text-danger"></span> <br />
            </div>
            <div class="form-floating mb-3">
                <label asp-for="Input.Password">کلمه عبور</label>
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="کلمه عبور را وارد کنید" /> 
                <span asp-validation-for="Input.Password" class="text-danger"></span> <br />
            </div>
            <div class="form-floating mb-3">
                <label asp-for="Input.ConfirmPassword">تایید کلمه عبور</label>
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="کلمه عبور را تکرار کنید" /> 
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span> <br />
            </div>
            <div class="form-floating mb-3">
                <label asp-for="Input.Inrole">نقش کاربر</label>
                <select asp-for="Input.Inrole" class="form-control" asp-items="@ViewBag.Inrole"></select> <br />
                <span asp-validation-for="Input.Inrole" class="text-danger"></span>
            </div>
            <button id="registerSubmit" type="submit" class="w-100 btn btn btn-primary">ثبت کاربر جدید</button>
            <a asp-page="./index" class="w-100 btn btn-default"> انصراف </a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function readURL(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();

                reader.onload = function (e) {
                    $('#imgpreview').attr('src', e.target.result);
                }

                reader.readAsDataURL(input.files[0]);
            }
        }

        $("#imgUpload").change(function () {
            readURL(this);
        });
    </script>
}
