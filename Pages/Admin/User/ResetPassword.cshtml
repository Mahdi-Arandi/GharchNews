@page
@model GharchNews.Pages.Admin.User.ResetPasswordModel
@{
    ViewData["Title"] = "تغییر رمز عبور";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
}

<h2>تغییر رمز عبور</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <label asp-for="Input.CurrentPassword" class="form-label"></label>
                <input asp-for="Input.CurrentPassword" class="form-control" autocomplete="username" aria-required="true" placeholder="لطفا رمز فعلی را وارد نمایید" />
                <span asp-validation-for="Input.CurrentPassword" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <label asp-for="Input.NewPassword" class="form-label"></label>
                <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="لطفا رمز جدید را وارد نمایید" />
                <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="لطفا رمز جدید را تایید نمایید" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
            <hr />
            <button type="submit" class="w-100 btn btn btn-primary">تغییر رمز عبور</button>
            <a asp-page="../index" class="w-100 btn btn-default"> انصراف </a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
