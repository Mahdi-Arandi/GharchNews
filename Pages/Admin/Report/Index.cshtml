@page
@model GharchNews.Pages.Admin.Report.IndexModel
@using GharchNews.Utilities
@using GharchNews.Roles

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
}

<hr />
<p>
    <a asp-page="Create" class="btn btn-success"> افزودن خبر </a>
</p>
<hr />

<table id="myDataTable" class="table table-striped table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Report[0].Image)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Report[0].title)
            </th>
            @if (User.IsInRole(SD.Admin))
            {
                <th>
                    @Html.DisplayNameFor(model => model.Report[0].IsHotNews)
                </th>
            }
            @if (User.IsInRole(SD.Admin))
            {
                <th>
                    @Html.DisplayNameFor(model => model.Report[0].IsSuccess)
                </th>
            }
            <th>
                @Html.DisplayNameFor(model => model.Report[0].CreateDate)
            </th>
            @if (User.IsInRole(SD.Admin))
            {
                <th>
                    @Html.DisplayNameFor(model => model.Report[0].Author)
                </th>
            }
            <th>
                @Html.DisplayNameFor(model => model.Report[0].View)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Report[0].ReportGroup)
            </th>
            @if (User.IsInRole(SD.User))
            {
                <th>
                    @Html.DisplayNameFor(model => model.Report[0].IsSuccess)
                </th>
            }
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Report)
        {
            <tr>
                <td>
                    @if (item.ReportGroup.GroupName == ReportGroups.MultiMedia)
                    {
                        <video src="/Img/ReportImages/@Html.DisplayFor(modelItem => item.Image)" preload="metadata" class="img-thumbnail" style="max-width:60px;max-height:44.69px"></video>
                    }
                    else
                    {
                        <img src="/Img/ReportImages/@Html.DisplayFor(modelItem => item.Image)" style="max-width:60px" class="img-thumbnail" />
                    }
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.title)
                </td>
                @if (User.IsInRole(SD.Admin))
                {
                    <td>
                        @* @Html.DisplayFor(modelItem => item.IsHotNews) *@
                        @if (item.IsHotNews == true)
                        {
                            <a asp-page-handler="IsHotNews" asp-route-id="@item.ReportId"> <i class="fa fa-check-square" style="font-size:18; color:orangered"></i> </a>
                        }
                        else
                        {
                            <a asp-page-handler="IsHotNews" asp-route-id="@item.ReportId"> <i class="fa fa-check-square" style="font-size:18; color:darkgray"></i> </a>
                        }
                    </td>


                }
                @if (User.IsInRole(SD.Admin))
                {
                    <td>
                        @* @Html.DisplayFor(modelItem => item.IsSuccess) *@
                        @if (item.IsSuccess == true)
                        {
                            <a asp-page-handler="IsSuccess" asp-route-id="@item.ReportId"> <i class="fa fa-check-square-o" style="font-size:18; color:blue"></i> </a>
                        }
                        else if (item.IsDraft == true)
                        {
                            <a asp-page-handler="IsSuccess" asp-route-id="@item.ReportId"> <i class="fa fa-check-square-o" style="font-size:18; color:darkgray"> پیش نویس </i> </a>
                        }
                        else
                        {
                            <a asp-page-handler="IsSuccess" asp-route-id="@item.ReportId"> <i class="fa fa-check-square-o" style="font-size:18; color:darkgray"></i> </a>
                        }
                    </td>
                }
                <td>
                    @item.CreateDate.ToShamsiWithTime()
                </td>
                @if (User.IsInRole(SD.Admin))
                {
                    <td>
                        @Html.DisplayFor(modelItem => item.Author)
                    </td>
                }
                <td>
                    @Html.DisplayFor(modelItem => item.View)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ReportGroup.GroupName)
                </td>

                @if (User.IsInRole(SD.User))
                {
                    <td>
                        @if (item.IsSuccess == true)
                        {
                            <a class="btn btn-success" disabled> منتشر شده </a>
                        }
                        else if (item.IsDraft == true)
                        {
                            <a class="btn btn-default" disabled> پیش نویس </a>
                        }
                        else
                        {
                            <a class="btn btn-warning" disabled> در صف انتشار </a>
                        }
                    </td>
                }

                <td class="keys" style="min-width:70px">
                    @if (User.IsInRole(SD.Admin))
                    {
                        <a asp-page="Edit" asp-route-id="@item.ReportId" asp-route-ReturnUrl="@ViewBag.ReturnUrl"><i class="fa fa-edit" style="color:darkorange;font-size:20px"></i></a>
                        <a asp-page="Details" asp-route-id="@item.ReportId" asp-route-ReturnUrl="@ViewBag.ReturnUrl"><i class="fa fa-info-circle" style="color:darkblue;font-size:20px"></i></a>
                        <a asp-page="Delete" asp-route-id="@item.ReportId" asp-route-ReturnUrl="@ViewBag.ReturnUrl"><i class="fa fa-trash" style="color:red;font-size:20px"></i></a>
                    }

                    else if (User.IsInRole(SD.User) && item.IsSuccess == false)
                    {
                        <a asp-page="Details" asp-route-id="@item.ReportId" asp-route-ReturnUrl="@ViewBag.ReturnUrl"><i class="fa fa-info-circle" style="color:darkblue;font-size:20px"></i></a>
                        <a asp-page="Edit" asp-route-id="@item.ReportId" asp-route-ReturnUrl="@ViewBag.ReturnUrl"><i class="fa fa-edit" style="color:darkorange;font-size:20px"></i></a>
                        <a asp-page="Delete" asp-route-id="@item.ReportId" asp-route-ReturnUrl="@ViewBag.ReturnUrl"><i class="fa fa-trash" style="color:red;font-size:20px"></i></a>
                    }

                    else if (User.IsInRole(SD.User) && item.IsSuccess == true)
                    {
                        <a asp-page="Details" asp-route-id="@item.ReportId" asp-route-ReturnUrl="@ViewBag.ReturnUrl"><i class="fa fa-info-circle" style="color:darkblue;font-size:20px"></i></a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {

    <link href="~/dist/datetable/datatable.min.css" rel="stylesheet" />
    <script src="~/dist/datetable/datatable.js"></script>

    <script>
        let table = new DataTable('#myDataTable');
    </script>
}