@page
@model GharchNews.Pages.Admin.Comment.NotConfirmedModel
@using GharchNews.Utilities

@{
    ViewData["Title"] = "NotConfirmed";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
}


<table id="myDataTable" class="table table-striped table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Comment[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Comment[0].Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Comment[0].CommentText)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Comment[0].CreateDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Comment[0].Report)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Comment)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Email)
                </td>
                <td>
                    @Html.Raw(item.CommentText)
                </td>
                <td>
                    @item.CreateDate.ToShamsiWithTime()
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Report.title)
                </td>
                <td class="keys" style="max-width:90px">
                    <a asp-route-id="@item.CommentId" asp-page-handler="Success" class="btn btn-sm btn-success" style="width:100%; margin:2px"><i class="fa fa-eye p-1"></i> نمایش نظر </a>
                    <a asp-page="./Edit" asp-route-id="@item.CommentId" asp-route-returnUrl="@ViewBag.returnUrl" class="btn btn-sm btn-warning" style="width:100%; margin:2px"><i class="fa fa-pencil p-1"></i> ویرایش </a>
                    <a asp-page="./Delete" asp-route-id="@item.CommentId" asp-route-returnUrl="@ViewBag.returnUrl" class="btn btn-sm btn-danger" style="width:100%; margin:2px"><i class="fa fa-trash p-1"></i> حذف </a>
                </td>
            </tr>
        }
    </tbody>
</table>


@section Scripts {

    <link href="~/dist/datetable/datatable.min.css" rel="stylesheet" />
    <script src="~/dist/datetable/datatable.js"></script>

    <script>
        let table = new DataTable('#myDataTable');
    </script>
}