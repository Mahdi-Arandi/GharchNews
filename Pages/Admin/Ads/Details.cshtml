@page
@model GharchNews.Pages.Admin.Ads.DetailsModel

@{
    ViewData["Title"] = "Details";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
}

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Ads.AdsName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Ads.AdsName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Ads.Email)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Ads.Email)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Ads.PhoneNumber)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Ads.PhoneNumber)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Ads.Subject)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Ads.Subject)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Ads.Price)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Ads.Price)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Ads.CreateDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Ads.CreateDate)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Ads.ExpireDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Ads.ExpireDate)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Ads.Image)
        </dt>
        <dd class="col-sm-10">
            <img src="/Img/AdsImages/@Model.Ads.Image" style="max-width:320px" class="img-thumbnail" /> <br />
            @Html.DisplayFor(model => model.Ads.Image)
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Ads.AdsId" class="btn btn-warning">ویرایش</a>
    <a asp-page="./Index" class="btn btn-default">بازگشت به لیست</a>
</div>
