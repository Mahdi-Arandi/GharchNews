@page
@model GharchNews.Pages.Admin.Ads.IndexModel
@using GharchNews.Utilities

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
}

<hr />
<p>
    <a asp-page="Create" class="btn btn-success"> افزودن آگهی </a>
</p>
<hr />

<table id="myDataTable" class="table table-striped table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Ads[0].AdsName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Ads[0].Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Ads[0].PhoneNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Ads[0].Subject)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Ads[0].Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Ads[0].CreateDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Ads[0].ExpireDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Ads[0].Image)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Ads)
        {
            <tr class="@((item.ExpireDate < DateTime.Now) ? "text-danger" : "")">
                <td>
                    @Html.DisplayFor(modelItem => item.AdsName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Email)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PhoneNumber)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Subject)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Price)
                </td>
                <td>
                    @item.CreateDate.ToShamsi()
                </td>
                <td>
                    @item.ExpireDate.ToShamsi()
                </td>
                <td>
                    <img src="~/Img/AdsImages/@Html.DisplayFor(modelItem => item.Image)" style="max-width:100px; max-height:100px" class="img-thumbnail" />
                </td>
                <td class="keys" style="max-width:90px">
                    <a asp-page="./Edit" asp-route-id="@item.AdsId" class="btn btn-sm btn-warning" style="width:100%; margin:2px"><i class="fa fa-pencil p-1"></i> ویرایش </a>
                    <a asp-page="./Details" asp-route-id="@item.AdsId" class="btn btn-sm btn-primary" style="width:100%; margin:2px"><i class="fa fa-information p-1"></i> جزئیات </a>
                    <a asp-page="./Delete" asp-route-id="@item.AdsId" class="btn btn-sm btn-danger" style="width:100%; margin:2px"><i class="fa fa-trash p-1"></i> حذف </a>
                </td>
            </tr>
        }
    </tbody>
</table>


@section Scripts {

    <link href="~/dist/datetable/datatable.min.css" rel="stylesheet" />
    <script src="~/dist/datetable/datatable.js"></script>

    <script>
        let table = new DataTable('#myDataTable');
    </script>
}