@page
@model GharchNews.Pages.Admin.ContactUs.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
}

<hr />

<table id="myDataTable" class="table table-striped table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ContactUs[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ContactUs[0].Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ContactUs[0].PhoneNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ContactUs[0].Subject)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ContactUs[0].Message)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ContactUs[0].CreateDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.ContactUs) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PhoneNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Subject)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Message)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreateDate)
            </td>
                <td class="keys" style="max-width:90px">
                    <a asp-page="./Edit" asp-route-id="@item.ContactId" class="btn btn-sm btn-warning" style="width:100%; margin:2px"><i class="fa fa-pencil p-1"></i> ویرایش </a>
                    <a asp-page="./Delete" asp-route-id="@item.ContactId" class="btn btn-sm btn-danger" style="width:100%; margin:2px"><i class="fa fa-trash p-1"></i> حذف </a>
                </td>
        </tr>
}
    </tbody>
</table>

@section Scripts {

    <link href="~/dist/datetable/datatable.min.css" rel="stylesheet" />
    <script src="~/dist/datetable/datatable.js"></script>

    <script>
        let table = new DataTable('#myDataTable');
    </script>
}