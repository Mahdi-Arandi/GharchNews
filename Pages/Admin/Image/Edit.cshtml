@page
@model GharchNews.Pages.Admin.Image.EditModel
@using GharchNews.Roles

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
}

<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Image.ImageId" />
            <input type="hidden" asp-for="Image.ImageName" />
            <input type="hidden" asp-for="Image.Id" />

            @if (User.IsInRole(SD.User))
            {
                <input type="hidden" asp-for="Image.CreateDate" />
            }
            <div class="form-group">
                <label asp-for="Image.ImageName" class="control-label"></label>
                <input asp-for="imgUp" id="imgUpload" />
                <img id="imgpreview" src="/Img/galleryImages/@Model.Image.Gallery.GalleryName/@Model.Image.ImageName" style="max-width:320px" class="img-thumbnail" /> <br />
                <span asp-validation-for="Image.ImageName" class="text-danger"></span>
            </div>

            @if (User.IsInRole(SD.Admin))
            {
                <div class="form-group">
                    <label asp-for="Image.CreateDate" class="control-label"></label>
                    <input asp-for="Image.CreateDate" class="form-control" dir="ltr" type="text" onclick="Mh1PersianDatePicker.Show(this,'@DateTime.Now.ToString("yyyy/MM/dd")')" />
                    <span asp-validation-for="Image.CreateDate" class="text-danger"></span>
                </div>
                <div class="form-group form-check">
                    <label class="form-check-label">
                        <input class="form-check-input" asp-for="Image.IsSuccess" /> @Html.DisplayNameFor(model => model.Image.IsSuccess)
                    </label>
                </div>
            }

            <div class="form-group">
                <label asp-for="Image.GalleryId" class="control-label"></label>
                <select asp-for="Image.GalleryId" class="form-control" asp-items="ViewBag.GalleryId"></select>
                <span asp-validation-for="Image.GalleryId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="ویرایش" class="btn btn-warning" />
                <a asp-page="./Index" asp-route-returnUrl="@ViewBag.returnUrl" class="btn btn-default"> بازگشت به لیست </a>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        function readURL(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();

                reader.onload = function (e) {
                    $('#imgpreview').attr('src', e.target.result);
                }

                reader.readAsDataURL(input.files[0]);
            }
        }

        $("#imgUpload").change(function () {
            readURL(this);
        });
    </script>

}

<link href="~/assets/calendar/mh1persiandatepicker.css" rel="stylesheet" />
<script src="~/assets/calendar/mh1persiandatepicker.js"></script>