@page
@model GharchNews.Pages.Admin.Hashtag.IndexModel
@using GharchNews.Roles

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
}

<hr />
<p>
    <a asp-page="Create" class="btn btn-success"> افزودن هشتگ </a>
</p>
<hr />

<table id="myDataTable" class="table table-striped table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Hashtags[0].HashtagName)
            </th>
            @if (User.IsInRole(SD.Admin))
            {
                <th>
                    @Html.DisplayNameFor(model => model.Hashtags[0].Id)
                </th>
            }
            <th>
                @Html.DisplayNameFor(model => model.Hashtags[0].IsSuccess)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Hashtags) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.HashtagName)
            </td>

                @if (User.IsInRole(SD.Admin))
                {
                    <td>
                        @Html.DisplayFor(modelItem => item.Users.Name)
                        @Html.DisplayFor(modelItem => item.Users.Family)
                    </td>
                }

                <td>
                    @if (User.IsInRole(SD.Admin))
                    {
                        @if (item.IsSuccess == false)
                        {
                            <a asp-page-handler="IsSuccess" asp-route-id="@item.HashtagId" class="btn btn-success"> انتشار هشتگ </a>
                        }
                        else
                        {
                            <a asp-page-handler="IsSuccess" asp-route-id="@item.HashtagId" class="btn btn-warning"> منتشر شده </a>
                        }
                    }
                    else if (User.IsInRole(SD.User) && item.Id == ViewBag.userId)
                    {
                        @if (item.IsSuccess == true)
                        {
                            <a disabled class="btn btn-success"> منتشر شده </a>
                        }
                        else
                        {
                            <a disabled class="btn btn-warning"> در صف انتشار </a>
                        }
                    }
                </td>



                <td>
                    @if (User.IsInRole(SD.Admin))
                    {
                        <a asp-page="Edit" asp-route-id="@item.HashtagId"><i class="fa fa-edit" style="color:darkorange;font-size:20px"></i></a>
                        <a asp-page-handler="Delete" asp-route-id="@item.HashtagId"><i class="fa fa-trash" style="color:red;font-size:20px"></i></a>
                    }
                    else if (User.IsInRole(SD.User) && item.IsSuccess == false)
                    {
                        <a asp-page="Edit" asp-route-id="@item.HashtagId"><i class="fa fa-edit" style="color:darkorange;font-size:20px"></i></a>
                        <a asp-page-handler="Delete" asp-route-id="@item.HashtagId"><i class="fa fa-trash" style="color:red;font-size:20px"></i></a>
                    }
                </td>
        </tr>
}
    </tbody>
</table>


@section Scripts {

    <link href="~/dist/datetable/datatable.min.css" rel="stylesheet" />
    <script src="~/dist/datetable/datatable.js"></script>

    <script>
        let table = new DataTable('#myDataTable');
    </script>
}