@page
@model GharchNews.Pages.Admin.Links.IndexModel
@using GharchNews.Roles

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
}

<hr />
<p>
    <a asp-page="Create" class="btn btn-success"> افزودن لینک </a>
</p>
<hr />

<table id="myDataTable" class="table table-striped table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Links[0].LinkName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Links[0].LinkAddress)
            </th>
            @if (User.IsInRole(SD.Admin))
            {
                <th>
                    @Html.DisplayNameFor(model => model.Links[0].Id)
                </th>
            }
            <th>
                @Html.DisplayNameFor(model => model.Links[0].IsSuccess)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Links) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.LinkName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LinkAddress)
            </td>
                @if (User.IsInRole(SD.Admin))
                {
                    <td>
                        @Html.DisplayFor(modelItem => item.Users.Name)
                        @Html.DisplayFor(modelItem => item.Users.Family)
                    </td>
                }

                <td>
                    @if (User.IsInRole(SD.Admin))
                    {
                        @if (item.IsSuccess == false)
                        {
                            <a asp-page-handler="IsSuccess" asp-route-id="@item.LinkId" class="btn btn-success"> انتشار لینک </a>
                        }
                        else
                        {
                            <a asp-page-handler="IsSuccess" asp-route-id="@item.LinkId" class="btn btn-warning"> منتشر شده </a>
                        }
                    }
                    else if (User.IsInRole(SD.User) && item.Id == ViewBag.userId)
                    {
                        @if (item.IsSuccess == true)
                        {
                            <a disabled class="btn btn-success"> منتشر شده </a>
                        }
                        else
                        {
                            <a disabled class="btn btn-warning"> در صف انتشار </a>
                        }
                    }
                </td>

                <td class="keys" style="max-width:40px">
                    @if (User.IsInRole(SD.Admin))
                    {
                        <a asp-page="./Edit" asp-route-id="@item.LinkId" class="btn btn-sm btn-warning" style="width:100%; margin:2px"><i class="fa fa-pencil p-1"></i> ویرایش </a>
                        <a asp-page-handler="Delete" asp-route-id="@item.LinkId" class="btn btn-sm btn-danger" style="width:100%; margin:2px"><i class="fa fa-trash p-1"></i> حذف </a>
                    }
                    else if (User.IsInRole(SD.User) && item.IsSuccess == false)
                    {
                        <a asp-page="./Edit" asp-route-id="@item.LinkId" class="btn btn-sm btn-warning" style="width:100%; margin:2px"><i class="fa fa-pencil p-1"></i> ویرایش </a>
                        <a asp-page-handler="Delete" asp-route-id="@item.LinkId" class="btn btn-sm btn-danger" style="width:100%; margin:2px"><i class="fa fa-trash p-1"></i> حذف </a>
                    }
                </td>
        </tr>
}
    </tbody>
</table>


@section Scripts {

    <link href="~/dist/datetable/datatable.min.css" rel="stylesheet" />
    <script src="~/dist/datetable/datatable.js"></script>

    <script>
        let table = new DataTable('#myDataTable');
    </script>
}