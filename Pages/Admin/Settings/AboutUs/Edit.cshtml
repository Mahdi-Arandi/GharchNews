@page
@model GharchNews.Pages.Admin.Settings.AboutUs.EditModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
}

<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="AboutUs.AboutId" />
            <div class="form-group">
                <label asp-for="AboutUs.AboutText" class="control-label"></label>
                <textarea asp-for="AboutUs.AboutText" class="form-control" rows="10"></textarea>
                <span asp-validation-for="AboutUs.AboutText" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="ویرایش" class="btn btn-warning" />
                <a asp-page="./Index" class="btn btn-default"> بازگشت به لیست </a>
            </div>
        </form>
    </div>
</div>


