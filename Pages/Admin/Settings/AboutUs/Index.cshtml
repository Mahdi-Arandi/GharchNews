@page
@model GharchNews.Pages.Admin.Settings.AboutUs.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
}

<p>
    @if(Model.AboutUs.Count == 0)
    {
        <a asp-page="Create" class="btn btn-success"> افزودن </a>
    }
    else
    {
        <a asp-page="Edit" asp-route-id="@Model.AboutUs[0].AboutId" class="btn btn-warning"> ویرایش </a>
    }
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.AboutUs[0].AboutText)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.AboutUs) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.AboutText)
            </td>
            <td>
                    <a asp-page-handler="Delete" asp-route-id="@item.AboutId" class="btn btn-sm btn-danger" style="width:100%; margin:2px"><i class="fa fa-trash p-1"></i> حذف </a>
            </td>
        </tr>
}
    </tbody>
</table>
