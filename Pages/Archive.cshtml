@page
@model GharchNews.Pages.ArchiveModel
@using GharchNews.Utilities
@{
}


<div class="col-12 col-lg-9 mb-5">
    <div class=" bg-light-subtle border-style rounded p-5">
        <h5 class="mb-3" style="font-weight:600;"> آرشیو اخبار </h5>
        @foreach (var item in Model.Reports)
        {
            <div class="card mb-3" style="border-top:3px solid #00b8d4;">
                <div class="row g-0">
                    <div class="col-md-3">
                        <a asp-page="Report" asp-route-id="@item.ReportId">
                            @if (item.ReportGroup.GroupName == ReportGroups.MultiMedia)
                            {
                                <video src="~/Img/ReportImages/@item.Image" preload="metadata" controls class="img-fluid rounded-start" alt="@item.ImageAlt" title="@item.ImageTitle" style="width:100%; height:100%"></video>
                            }
                            else
                            {
                                <img src="~/Img/ReportImages/@item.Image" class="img-fluid rounded-start" alt="@item.ImageAlt" title="@item.ImageTitle" style="width:100%; height:100%">
                            }
                        </a>
                    </div>
                    <div class="col-md-9">
                        <div class="card-body p-2">
                            <a asp-page="Report" asp-route-id="@item.ReportId" class="card-title text-decoration-none" style="font-size:.8rem;font-weight:900;"> @item.title </a>
                            <p class="card-text"> @item.Description </p>
                            <p class="card-text float-end my-0"> <i class="fas fa-clock" style="color: #b9b9bb; font-size: .7rem;"></i> <small class="text-body-secondary"> @item.CreateDate.ToShamsi() </small></p>
                            <a asp-page="Group" asp-route-Group="@item.ReportGroup.GroupName">
                                <p class="card-text float-end mx-3"> <i class="fas fa-folder-open" style="color: #b9b9bb; font-size: .7rem;"></i> <small class="text-body-secondary"> @item.ReportGroup.GroupName </small></p>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

        }

        <!-- Pagination -->
        @if (ViewBag.itemCount > ViewBag.take)
        {
            <div class="row">
                <nav aria-label="Page navigation example">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @((ViewBag.pageId==1)? "disabled" : "")" style="padding: 20px 0;"><a asp-route-group="@ViewBag.GroupName" asp-route-pageid="1" class="page-link" style="font-size: .7rem;">صفحه اول</a></li>
                        <li class="page-item @((ViewBag.pageId==1)? "disabled" : "")" style="padding: 20px 0;"><a asp-route-group="@ViewBag.GroupName" asp-route-pageid="@ViewBag.previousPage" class="page-link" style="font-size: .7rem;"> قبلی </a></li>
                        @for (int i = 1; i <= ViewBag.pageCount; i++)
                        {
                            <li class="@((ViewBag.pageId == i)? "active" : "")" style="padding: 20px 0;"><a asp-route-group="@ViewBag.GroupName" asp-route-pageid="@i" class="page-link" style="font-size: .7rem;"> @i </a></li>
                        }
                        <li class="page-item @((ViewBag.pageId==ViewBag.pageCount)? "disabled" : "")" style="padding: 20px 0;"><a asp-route-group="@ViewBag.GroupName" asp-route-pageid="@ViewBag.nextPage" class="page-link" style="font-size: .7rem;">بعدی</a></li>
                        <li class="page-item @((ViewBag.pageId==ViewBag.pageCount)? "disabled" : "")" style="padding: 20px 0;"><a asp-route-group="@ViewBag.GroupName" asp-route-pageid="@ViewBag.pageCount" class="page-link" style="font-size: .7rem;">صفحه آخر</a></li>
                    </ul>
                </nav>
            </div>
        }
        <!-- End Pagination -->

    </div>
</div>


<div class="col-12 d-none col-lg-3 d-lg-block ">
    <div class="my-3">
        <!-- Start ColorPalet -->
        @{
            await Html.RenderPartialAsync("_ColorPalet");
        }
        <!-- End ColorPalet -->
        <!-- LastNews -->
        @await Component.InvokeAsync("LastNewsComponent")
        <!-- End LastNews -->
    </div>

</div>