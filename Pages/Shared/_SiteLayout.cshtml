
<!DOCTYPE html>
<html lang="en" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title> وبسایت نشریه خبری قارچ</title>
    <link href="~/assets/img/logo/gharchnews.png" rel="icon">
    <!-- Main Style -->
    <link rel="stylesheet" href="/Assets/Style/style.css">
    <!-- bootstrap -->
    <link rel="stylesheet" href="/Assets/bootstrap-5.3.2-dist/css/bootstrap.rtl.min.css" />
    <!-- flexslider -->
    <link type="text/css" href="/Assets/FlexSlider/flexslider.css" rel="stylesheet" />
    <!-- header and nav Css Style -->
    <link type="text/css" href="/Assets/Css/am-menu.css" rel="stylesheet" />
    <!-- Color-Palet -->
    <link type="text/css" href="/Assets/Css/demo-style.css" rel="stylesheet" />
    <!-- navtab in HomePage -->
    <link type="text/css" href="/Assets/Css/NavTabStyle.css" />
    <!-- TopReport in HomePage -->
    <link type="text/css" href="/Assets/Css/TopReportsStyle.css" rel="stylesheet" />
    <!-- FlexSlider Css in HomePage -->
    <link type="text/css" href="/Assets/FlexSlider/flexslider.css" rel="stylesheet" />
    <!-- Font-awesome -->
    <link href="~/dist/font-awesome/font-awesome.min.css" rel="stylesheet" />
</head>

<body>
    <header class="steel-man am-header sticky">
        <div class="logo" title=" نشریه خبری قارچ ">
            <a asp-page="./index">
                <img src="/Assets/Img/Logo/GharchNews.png" style="width: 120px; height: 40px;">
            </a>
        </div>

        <div class="search-trigger">
            <div class='s-wrapper'>
                <div id='circle'></div>
                <div id='bar'></div>
            </div>
        </div>
        <!--Search-trigger-->
        <div class="search-container">
            <div class="search-box">
                <form action="~/Search" class="search-form">
                    <input type="text" name="q" placeholder="جستجو کنید" id="search" autocomplete="off">
                    <div class="search-icon">
                        <!-- <i class="fa fa-search search-icon"></i> -->
                        <button style="background-color:transparent; border:none; color:white;"><i class="fa fa-search "></i></button>
                    </div>
                </form>
            </div>
            <!--//search-box-->
        </div>
        <!--//search-container-->
        <!--Menu Icon-->
        <div class="menu-trigger"></div>
    </header>
    <!--Side Menu Start-->
    @await Component.InvokeAsync("SideMenuComponent")
    <!--Side Menu End-->
    <!--Main Start-->
    <main>
        <!--Start container -->
        <div class="container">
            <div class="row" style="margin-top: 50px;">
                @RenderBody()
            </div>
        </div>
    </main>
    <!--End Main -->
    <!--Start Footer -->
    @await Component.InvokeAsync("FooterComponent")
    <!--End Footer -->
    <!-- header and nav scripts -->
    <script src="/Assets/Js/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/Assets/Js/run_prettify.js"> </script>
    <script src="/Assets/Js/am-menu.js"></script>
    <script src="/Assets/Js/scripts.js"></script>
    <script src="/Assets/Js/demo-only.js"></script>

    <!-- fontawesome -->
    <script src="/Assets/fontawesome/all.min.js"></script>

    <!-- flexslider -->
    <!-- <script type="text/javascript" src="/Assets/FlexSlider/jquery.min.js"></script> -->
    <script type="text/javascript" src="/Assets/FlexSlider/jquery.flexslider.js"></script>

    <!-- PersianDigits -->
    <script src="~/Assets/js/replacedigits/topersiandigits.js"></script>
    <script>

        $(document).ready(function () {

            $('body').traverse();

        });

    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>