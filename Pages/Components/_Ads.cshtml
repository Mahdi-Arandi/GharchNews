@model IEnumerable<GharchNews.Models.Ads>
@using GharchNews.Utilities


<div class="row mb-5">
    <div class="bg-body-secondary shadow Ads">
        <ul class="list-unstyled my-2 ">
            @foreach(var item in Model)
            {
                <li class="mb-2"><a><img class="w-100 h-100" src="~/Img/AdsImages/@item.Image"></a></li>
            }
        </ul>
    </div>
</div>