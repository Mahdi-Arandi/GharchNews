@model IEnumerable<GharchNews.Models.Report>
@using GharchNews.Utilities




<div class="row mb-5">
    <div class="bg-body-secondary rounded shadow position-relative LastNews-body">
        <div class="position-absolute bg-body-secondary px-3 pt-2 LastNews-text">آخرین اخبار</div>
        <ul class="list-unstyled mt-3">
            @foreach(var item in Model)
            {
                <li class="border-bottom py-2">
                    <a asp-page="./Report" asp-route-id="@item.ReportId" class="text-decoration-none">
                        <p class="LastNews-items">
                            <i class="fa fa-newspaper"></i>
                            @item.title
                        </p>
                    </a>
                </li>
            }
        </ul>
        <div class="text-center p-3">
            <a asp-page="./Archive" class="btn btn-secondary w-100">آخــرین اخبـــار ...</a>
        </div>
    </div>
</div>
