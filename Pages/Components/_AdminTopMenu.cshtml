@model GharchNews.Models.ViewModels.AdminTopMenuVM
@using GharchNews.Utilities
@using GharchNews.Roles


<header class="main-header">
    <!-- Logo -->
    <a href="#" class="logo">
        <!-- mini logo for sidebar mini 50x50 pixels -->
        <span class="logo-mini">پنل</span>
        <!-- logo for regular state and mobile devices -->
        <span class="logo-lg"><b>کنترل پنل مدیریت</b></span>
    </a>
    <!-- Header Navbar: style can be found in header.less -->
    <nav class="navbar navbar-static-top">
        <!-- Sidebar toggle button-->
        <a href="#" class="sidebar-toggle" data-toggle="push-menu" role="button">
            <span class="sr-only">Toggle navigation</span>
        </a>

        <div class="navbar-custom-menu">
            <ul class="nav navbar-nav">


                @if (User.IsInRole(SD.Admin))
                {
                    <!-- Notifications: style can be found in dropdown.less -->
                    <li class="dropdown messages-menu">
                        <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                            <i class="fa fa-newspaper-o"></i>
                            <span class="label bg-aqua"> @Model.NotConfirmedReportCount </span>
                        </a>
                        <ul class="dropdown-menu">
                            <li class="header"> @Model.NotConfirmedReportCount خبر جدید</li>
                            <li>
                                <!-- inner menu: contains the actual data -->
                                <ul class="menu">
                                    @foreach (var item in Model.Reports)
                                    {
                                        <li>
                                            <!-- start message -->
                                            <a asp-page="/Admin/Report/Edit" asp-route-id="@item.ReportId">
                                                <div class="pull-right">
                                                    <i class="fa fa-newspaper-o icon"></i>
                                                    <img src="/Img/reportImages/@item.Image" class="img-circle" alt="User Image">
                                                </div>
                                                <h4>
                                                    @item.Users.Name  @item.Users.Family
                                                    <small><i class="fa fa-clock-o"></i>  @item.CreateDate.ToShamsi()  </small>
                                                </h4>
                                                <p> @item.Description </p>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </li>
                            <li class="footer"><a href="~/Admin/Report/NotConfirmed">نمایش همه خبر ها</a></li>
                        </ul>
                    </li>

                    <!-- Messages: style can be found in dropdown.less-->
                    <li class="dropdown messages-menu">
                        <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                            <i class="fa fa-envelope-o"></i>
                            <span class="label label-success"> @Model.NotConfirmedCommentCount </span>
                        </a>
                        <ul class="dropdown-menu">
                            <li class="header">@Model.NotConfirmedCommentCount نظر خوانده نشده</li>
                            <li>
                                <!-- inner menu: contains the actual data -->
                                <ul class="menu">
                                    @foreach (var item in Model.Comments)
                                    {
                                        <li>
                                            <!-- start message -->
                                            <a asp-page="/Admin/Comment/Edit" asp-route-id="@item.CommentId">
                                                <div class="pull-right">
                                                    <i class="fa fa-envelope-o icon"></i>
                                                    <!-- <img src="dist/img/user1-128x128.jpg" class="img-circle" alt="User Image"> -->
                                                </div>
                                                <h4>
                                                    @item.Name
                                                    <small><i class="fa fa-clock-o"></i>  @item.CreateDate.ToShamsi()  </small>
                                                </h4>
                                                <p> @Html.Raw(item.CommentText) </p>
                                            </a>
                                        </li>
                                    }
                                </ul>

                            </li>
                            <li class="footer"><a href="~/Admin/Comment/NotConfirmed">نمایش تمام نظرات</a></li>
                        </ul>
                    </li>

                    <!-- Notifications: style can be found in dropdown.less -->
                    <li class="dropdown messages-menu">
                        <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                            <i class="fa fa-bell-o"></i>
                            <span class="label label-warning"> @Model.ContactUsCount </span>
                        </a>
                        <ul class="dropdown-menu">
                            <li class="header"> @Model.ContactUsCount پیام جدید</li>
                            <li>
                                <!-- inner menu: contains the actual data -->
                                <ul class="menu">
                                    @foreach (var item in Model.Contacts)
                                    {
                                        <li>
                                            <!-- start message -->
                                            <a asp-page="/Admin/ContactUs/Edit" asp-route-id="@item.ContactId">
                                                <div class="pull-right">
                                                    <i class="fa fa-bell-o icon"></i>
                                                    <img src="/dist/img/avatar04.png" class="img-circle" alt="User Image">
                                                </div>
                                                <h4>
                                                    @item.Name
                                                    <small><i class="fa fa-clock-o"></i> @item.CreateDate.ToShamsi() </small>
                                                </h4>
                                                <p> @item.Subject </p>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </li>
                            <li class="footer"><a href="~/Admin/ContactUs">نمایش همه پیام ها</a></li>
                        </ul>
                    </li>
                }



                <!-- User Account: style can be found in dropdown.less -->
                <li class="dropdown user user-menu">
                    <a href="#" class="dropdown-toggle" data-toggle="dropdown">

                        @if (Model.ProfileImage == null)
                        {
                            <img src="~/Img/ProfileImages/پروفایل.jpg" class="user-image" alt="User Image">
                        }
                        else
                        {
                            <img src="~/Img/ProfileImages/@Model.ProfileImage" class="user-image" alt="User Image">
                        }

                        <span class="hidden-xs"> @Model.Name @Model.Family </span>
                    </a>
                    <ul class="dropdown-menu">
                        <!-- User image -->
                        <li class="user-header">


                            @if (Model.ProfileImage == null)
                            {
                                <img src="~/Img/ProfileImages/پروفایل.jpg" class="img-circle" alt="User Image">
                            }
                            else
                            {
                                <img src="~/Img/ProfileImages/@Model.ProfileImage" class="img-circle" alt="User Image">
                            }


                            <p>
                                @Model.Name @Model.Family
                                <small> @Model.InRole </small>
                            </p>
                        </li>
                        <!-- Menu Body -->
                        @*                         <li class="user-body">
                        <div class="row">
                        <div class="col-xs-4 text-center">
                        <a href="#">صفحه من</a>
                        </div>
                        <div class="col-xs-4 text-center">
                        <a href="#">فروش</a>
                        </div>
                        <div class="col-xs-4 text-center">
                        <a href="#">دوستان</a>
                        </div>
                        </div>
                        <!-- /.row -->
                        </li> *@
                        <!-- Menu Footer-->
                        <li class="user-footer">
                            <div class="pull-right">
                                <form class="form-inline">

                                    <a asp-page="/Admin/User/Profile" class="btn btn-default btn-flat"> پروفایل </a>
                                </form>
                            </div>
                            <div class="pull-left">
                                <form class="form-inline" asp-page="/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                                    <button type="submit" class="btn btn-default btn-flat"> خروج </button>
                                </form>
                            </div>
                        </li>
                    </ul>
                </li>
                <!-- Control Sidebar Toggle Button -->
                @if (User.IsInRole(SD.Admin))
                {
                    <li>
                        <a href="#" data-toggle="control-sidebar"><i class="fa fa-gears"></i></a>
                    </li>
                }

            </ul>
        </div>
    </nav>
</header>
